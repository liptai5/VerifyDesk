# Copy to .env and adjust. Every option below is free.
# Run `npm run doctor` to check what is active.

# Which provider powers the AI parts: groq | ollama | mock
#   groq   -> free cloud tier, needs GROQ_API_KEY below (no credit card). Recommended.
#   ollama -> fully local, no keys (needs Ollama + `ollama pull gemma4:e4b` and a good GPU)
#   mock   -> no AI: recorded answers + keyword rules (demo mode, CI)
# If the chosen provider can't start (e.g. empty key), the server falls back to mock and says so.
PROVIDER=groq

# Optional per-role overrides (fall back to PROVIDER)
# LLM_PROVIDER=groq
# STT_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# --- Groq (free cloud tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Verifier (step 5) ---
# agent -> the AI chooses VerifyDesk's next step and words its lines; safety rules in the code check every choice
# fixed -> standard steps and lines only (no extra AI calls)
VERIFIER=agent
# How long to wait for the AI's choice before using the standard step (milliseconds)
AGENT_TIMEOUT_MS=15000

# --- Server ---
PORT=8787
