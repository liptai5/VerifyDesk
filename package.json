{
  "name": "verifydesk",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time AI identity verifier for IT help-desk calls. Don't detect the deepfake \u2014 make it irrelevant.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @verifydesk/server\" \"npm run dev -w @verifydesk/web\"",
    "demo": "cross-env PROVIDER=mock npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "simulate": "tsx scripts/simulate-call.ts",
    "build": "npm run build -w @verifydesk/web",
    "start": "npm run build && npm run start -w @verifydesk/server"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1",
    "concurrently": "^10.0.7"
  }
}
