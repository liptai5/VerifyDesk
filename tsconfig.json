{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@verifydesk/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/server/src", "apps/server/test", "scripts/*.ts"]
}
